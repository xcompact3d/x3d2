&domain_settings
! Fast TGV smoke case for the regression suite: 32^3, ~100 steps.
! Not physically resolved -- its only job is to catch crashes, NaNs and
! numerical drift by comparing monitoring.csv against a committed golden file.
flow_case_name = 'tgv'

L_global = 6.283185307179586d0, 6.283185307179586d0, 6.283185307179586d0

dims_global = 32, 32, 32

nproc_dir = 1, 1, 2

BC_x = 'periodic', 'periodic'
BC_y = 'periodic', 'periodic'
BC_z = 'periodic', 'periodic'
/End

&solver_params
Re = 1600d0
time_intg = 'AB3'
dt = 0.005d0
n_iters = 100
n_output = 10
poisson_solver_type = 'FFT'
der1st_scheme = 'compact6'
der2nd_scheme = 'compact6'
interpl_scheme = 'classic'
stagder_scheme = 'compact6'
/End
