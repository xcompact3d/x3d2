&domain_settings
! Small cylinder smoke case for the regression suite: 65 x 33 x 16, 30 steps.
! Not physically resolved -- it runs the 100 FFT Poisson solver with the
! immersed boundary mask in ibm_cylinder.bp, shared with the 110 and 111
! cases (a cylinder of radius 0.8 about x = 5, y = 6, axis along z). It
! catches crashes, NaNs and numerical drift by comparing monitoring.csv
! against a committed golden file. The test copies ibm_cylinder.bp into its
! work directory. The mask is sampled on the 33 y vertices of the 110 grid,
! where y is Neumann and dy = 12/32. Periodic y has 33 cells rather than 32,
! so L_y = 12.375 keeps dy = 0.375 and the cylinder where the mask puts it.
flow_case_name = 'cylinder'

L_global = 20d0, 12.375d0, 6d0

dims_global = 65, 33, 16

nproc_dir = 1, 1, 1

BC_x = 'dirichlet', 'dirichlet'
BC_y = 'periodic', 'periodic'
BC_z = 'periodic', 'periodic'
/End

&solver_params
Re = 300d0
time_intg = 'AB3'
dt = 0.0075d0
n_iters = 30
n_output = 5
poisson_solver_type = 'FFT'
der1st_scheme = 'compact6'
der2nd_scheme = 'compact6'
interpl_scheme = 'classic'
stagder_scheme = 'compact6'
ibm_on = T
ibm_file = 'ibm_cylinder.bp'
/End

&checkpoint_params
snapshot_freq = 0
/End

&cylinder_nml
init_noise = 0. 0. 0.
inlet_noise = 0. 0. 0.
/End
