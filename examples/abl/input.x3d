&domain_settings
! Flow case
flow_case_name = 'abl'

! Global domain length (Lx x Ly x Lz), wall-normal is y.
! Neutral ABL box of Deskos (2019), case C1: pi*H x H x pi*H, H = 1000 m.
L_global = 3140d0, 1000d0, 3140d0

! Global number of cells in each direction
dims_global = 64, 65, 64

! Domain decomposition in each direction
nproc_dir = 1, 1, 1

! BC options are 'periodic' | 'neumann' | 'dirichlet'
! Periodic in x/z; no-slip floor and free-slip lid in the wall-normal y.
BC_x = 'periodic', 'periodic'
BC_y = 'dirichlet', 'neumann'
BC_z = 'periodic', 'periodic'
/End

&solver_params
! 125000 steps of 0.8 s = 100000 s, about 45 H/u_star.
Re = 66667d0
time_intg = 'AB3' ! 'AB[1-4]' | 'RK[1-4]'
dt = 0.8d0
n_iters = 125000
n_output = 50
! Explicit low-pass filter on the velocity, as Incompact3d does for ABL runs.
! Removes the 2*dx mode the compact schemes cannot dissipate and the staggered
! projection cannot see; without it the skew-symmetric convection leaks mean
! momentum and the boundary layer decays away.
spatial_filter = T
filter_alpha = 0.49d0
poisson_solver_type = 'FFT' ! 'FFT' | 'CG'
der1st_scheme = 'compact6'
der2nd_scheme = 'compact6'
interpl_scheme = 'classic'
stagder_scheme = 'compact6'
/End

&les_params
! Static Smagorinsky closure with the Mason-Thomson rough-wall damping.
model = 'smagorinsky'
smagorinsky_constant = 0.14d0
wall_damping = T
wall_damping_n = 3d0
/End

&abl_nml
! Physical parameters (Deskos 2019 neutral ABL)
z0 = 0.1d0
u_star = 0.45d0
delta = 1000d0
kappa = 0.4d0
! Wall-model sampling height, in grid spacings above the floor
dsampling = 3d0
! Log-law initial profile with 50% noise on u and 0.5 m/s on v and w
init_noise = 0.5d0, 0.5d0, 0.5d0

! Driving mechanism toggles (at least one must be enabled)
pressure_gradient = T
coriolis = F
mass_conserve = F
damping = F

! Average the mean profile over the second half of the run
profile_start_iter = 62500
profile_file = 'abl_profile.csv'
/End

&checkpoint_params
checkpoint_freq = 12500
keep_checkpoint = F
checkpoint_prefix = 'abl_checkpoint'
/End

&inflow_nml
! Precursor output for a successor run (needs ADIOS2). Sample u, v, w on the
! last x plane every step and write them in files of ntimesteps planes.
write_planes = F
plane_x_index = 0
ntimesteps = 100
sample_every = 1
inflow_prefix = 'inflow'
! Successor input: impose a precursor's planes at an x inlet. Needs
! BC_x = 'dirichlet', 'dirichlet'; the driving switches above may all be off.
read_planes = F
inflow_read_prefix = '../precursor/inflow'
ninflows = 1
/End
