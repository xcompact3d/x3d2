&domain_settings
! Flow case
flow_case_name = 'abl'

! Global domain length (Lx x Ly x Lz), wall-normal is y.
! Same box and grid as input.x3d, driven by a geostrophic wind on an f-plane.
L_global = 3140d0, 1000d0, 3140d0

! Global number of cells in each direction
dims_global = 64, 65, 64

! Domain decomposition in each direction
nproc_dir = 1, 1, 1

! BC options are 'periodic' | 'neumann' | 'dirichlet'
! Periodic in x/z; no-slip floor and free-slip lid in the wall-normal y.
BC_x = 'periodic', 'periodic'
BC_y = 'dirichlet', 'neumann'
BC_z = 'periodic', 'periodic'
/End

&solver_params
Re = 66667d0
time_intg = 'AB3' ! 'AB[1-4]' | 'RK[1-4]'
dt = 0.8d0
n_iters = 125000
n_output = 50
! Explicit low-pass filter on the velocity, as Incompact3d does for ABL runs.
spatial_filter = T
filter_alpha = 0.49d0
poisson_solver_type = 'FFT' ! 'FFT' | 'CG'
der1st_scheme = 'compact6'
der2nd_scheme = 'compact6'
interpl_scheme = 'classic'
stagder_scheme = 'compact6'
/End

&les_params
! Static Smagorinsky closure with the Mason-Thomson rough-wall damping.
model = 'smagorinsky'
smagorinsky_constant = 0.14d0
wall_damping = T
wall_damping_n = 3d0
/End

&abl_nml
z0 = 0.1d0
! u_star sets the damping-layer strength and reference; the wall stress and
! the friction velocity follow from the geostrophic drive.
u_star = 0.45d0
delta = 1000d0
kappa = 0.4d0
dsampling = 3d0
! Geostrophic wind along x and Coriolis parameter f (1/s)
u_geo = 10d0, 0d0, 0d0
coriolis_freq = 1d-4
! Uniform u_geo initial field with 5% noise on u and 0.05 m/s on v and w
init_noise = 0.05d0, 0.05d0, 0.05d0

! Coriolis drive instead of the pressure gradient, with a Rayleigh damping
! layer at the lid
pressure_gradient = F
coriolis = T
mass_conserve = F
damping = T

profile_start_iter = 62500
profile_file = 'abl_ekman_profile.csv'
/End

&checkpoint_params
checkpoint_freq = 12500
keep_checkpoint = F
checkpoint_prefix = 'abl_ekman_checkpoint'
/End
