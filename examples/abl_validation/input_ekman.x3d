&domain_settings
flow_case_name = 'abl'
L_global = 3140d0, 1000d0, 3140d0
dims_global = 64, 65, 64
nproc_dir = 1, 1, 1
BC_x = 'periodic', 'periodic'
BC_y = 'dirichlet', 'neumann'
BC_z = 'periodic', 'periodic'
/End

&solver_params
Re = 66667d0
time_intg = 'AB3'
dt = 0.8d0
n_iters = 100000
n_output = 50
! Explicit low-pass filter on the velocity, as Incompact3d does for ABL runs.
! Removes the 2*dx mode the compact schemes cannot dissipate and the staggered
! projection cannot see; without it the skew-symmetric convection leaks mean
! momentum and the boundary layer decays away.
spatial_filter = T
filter_alpha = 0.4d0
poisson_solver_type = 'FFT'
der1st_scheme = 'compact6'
der2nd_scheme = 'compact6'
interpl_scheme = 'classic'
stagder_scheme = 'compact6'
/End

&les_params
model = 'smagorinsky'
smagorinsky_constant = 0.14d0
wall_damping = T
wall_damping_n = 3d0
/End

&abl_nml
z0 = 0.1d0
u_star = 0.45d0
delta = 1000d0
kappa = 0.4d0
u_geo = 10d0, 0d0, 0d0
coriolis_freq = 1d-4
init_noise = 0.05d0, 0.05d0, 0.05d0
pressure_gradient = F
coriolis = T
mass_conserve = F
damping = T
profile_start_iter = 25000
profile_file = 'abl_ekman_profile.csv'
/End

&checkpoint_params
checkpoint_freq = 10000
keep_checkpoint = T
checkpoint_prefix = 'abl_ekman_checkpoint'
/End
