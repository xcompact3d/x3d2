&TurbineSpecs
name = 'NTNU_HATT_2'         ! turbine name (output file prefix)
origin = 4.47, 0.817, 1.7     ! rotor centre [m]
numblades = 3
blade_geom = 'Blade_N52.al'  ! blade geometry
numfoil = 1                  ! number of airfoils to interpolate between
afname = 'Airfoils/S826.air'
towerFlag = 1                ! 0: no tower, 1: tower
towerOffset = 0.14           ! tower offset from the rotor centre in x
tower_geom = 'Tower.al'
tower_drag = 1.0
tower_lift = 0.3
tower_strouhal = 0.21
TypeFlag = 1                 ! 1: horizontal axis
OperFlag = 1                 ! 1: constant rotation, 2: NREL controller,
                             ! 4: omega from an upstream probe
uref = 10.0                  ! reference velocity [m/s]
tsr = 8                      ! tip speed ratio
RotFlag = 2                  ! 1: clockwise, 2: counterclockwise
EndEffectsFlag = 0           ! 0: none, 1: Glauert, 2: Shen et al. 2005
TipCorr = 0
RootCorr = 0
/
